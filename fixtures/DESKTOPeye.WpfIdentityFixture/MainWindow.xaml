<Window x:Class="DESKTOPeye.WpfIdentityFixture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DESKTOPeye.WpfIdentityFixture"
        Title="DESKTOPeye Identity Fixture" Height="850" Width="1050"
        AutomationProperties.AutomationId="FixtureMainWindow">
  <DockPanel>
    <Menu DockPanel.Dock="Top" AutomationProperties.AutomationId="MainMenu">
      <MenuItem Header="Actions" AutomationProperties.AutomationId="ActionsMenu">
        <MenuItem Header="Increment command" AutomationProperties.AutomationId="MenuCommand" Click="MenuCommand_Click"/>
      </MenuItem>
    </Menu>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12">
        <TextBlock FontSize="18" FontWeight="Bold" Text="DESKTOPeye WPF Identity Torture Fixture"/>
        <WrapPanel Margin="0,8,0,8">
          <TextBox x:Name="PrimaryText" Width="220" Text="seed" AutomationProperties.AutomationId="PrimaryText" TextChanged="PrimaryText_TextChanged"/>
          <TextBox x:Name="PhysicalText" Width="220" Margin="8,0,0,0" Text="" AutomationProperties.AutomationId="PhysicalText" TextChanged="PhysicalText_TextChanged"/>
          <CheckBox x:Name="FeatureToggle" Margin="12,4" Content="Feature" AutomationProperties.AutomationId="FeatureToggle" Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>
          <Button x:Name="AsyncAction" Margin="8,0" Content="Async Enabled" AutomationProperties.AutomationId="AsyncAction" IsEnabled="False" Click="AsyncAction_Click"/>
        </WrapPanel>
        <WrapPanel Margin="0,4">
          <Button Content="Continue" AutomationProperties.AutomationId="Continue" Click="OpenConfirm_Click"/>
          <Button Margin="8,0" Content="Replace Control" AutomationProperties.AutomationId="ReplaceControl" Click="ReplaceControl_Click"/>
          <Button Margin="8,0" Content="Recreate Parent" AutomationProperties.AutomationId="RecreateParent" Click="RecreateParent_Click"/>
          <Button Margin="8,0" Content="Navigate Same HWND" AutomationProperties.AutomationId="Navigate" Click="Navigate_Click"/>
          <Button Margin="8,0" Content="Duplicate" AutomationProperties.AutomationId="DupId" Click="DuplicateA_Click"/>
          <Button Margin="8,0" Content="Duplicate" AutomationProperties.AutomationId="DupId" Click="DuplicateB_Click"/>
          <Button Margin="8,0" Content="Missing Id" Click="MissingId_Click"/>
        </WrapPanel>
        <Border BorderBrush="Gray" BorderThickness="1" Padding="6" Margin="0,8">
          <StackPanel x:Name="DynamicParent" AutomationProperties.AutomationId="DynamicParent"/>
        </Border>
        <Grid Margin="0,8">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock FontWeight="Bold" Text="Keyed recycling collection"/>
            <WrapPanel>
              <Button Content="Sort" AutomationProperties.AutomationId="SortKeyed" Click="SortKeyed_Click"/>
              <Button Margin="6,0" Content="Filter" AutomationProperties.AutomationId="FilterKeyed" Click="FilterKeyed_Click"/>
              <Button Content="Clear Filter" AutomationProperties.AutomationId="ClearFilter" Click="ClearFilter_Click"/>
              <TextBlock x:Name="ViewEpochText" Margin="10,4" Text="view:0" AutomationProperties.AutomationId="ViewEpoch"/>
            </WrapPanel>
            <ListBox x:Name="KeyedList" Height="260" ItemsSource="{Binding KeyedRows}" AutomationProperties.AutomationId="KeyedList"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                     SelectionChanged="KeyedList_SelectionChanged">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Key}"/>
                  <Setter Property="AutomationProperties.Name" Value="{Binding Key}"/>
                  <Setter Property="AutomationProperties.AutomationId" Value=""/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock FontWeight="Bold" Text="Unkeyed duplicate collection"/>
            <ListBox x:Name="UnkeyedList" Height="260" ItemsSource="{Binding UnkeyedRows}" AutomationProperties.AutomationId="UnkeyedList"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
          </StackPanel>
        </Grid>
        <TabControl Height="140" AutomationProperties.AutomationId="Tabs">
          <TabItem Header="Tree"><TreeView AutomationProperties.AutomationId="FixtureTree"><TreeViewItem Header="Root"><TreeViewItem Header="Leaf A"/><TreeViewItem Header="Leaf B"/></TreeViewItem></TreeView></TabItem>
          <TabItem Header="Rich"><RichTextBox AutomationProperties.AutomationId="RichText"><FlowDocument><Paragraph>Rich text fixture</Paragraph></FlowDocument></RichTextBox></TabItem>
        </TabControl>
        <TextBlock Margin="0,8,0,2" FontWeight="Bold" Text="UIA-inaccessible visual target"/>
        <local:VisualOnlySurface x:Name="VisualSurface" Height="130"/>
        <TextBlock x:Name="StateText" Margin="0,8" Text="ready" AutomationProperties.AutomationId="StateText"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>